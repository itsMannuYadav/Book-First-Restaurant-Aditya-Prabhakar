rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function ownsRestaurant(restaurantId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId
          == request.auth.uid;
    }

    function validOrderStatus(status) {
      return status in [
        'pending', 'confirmed', 'declined', 'ready', 'completed', 'cancelled'
      ];
    }

    function validOwnerOrderTransition() {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return (before == 'pending' && after in ['confirmed', 'declined', 'cancelled'])
        || (before == 'confirmed' && after in ['ready', 'cancelled'])
        || (before == 'ready' && after in ['completed', 'cancelled']);
    }

    match /users/{userId} {
      allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Guest menus must be publicly readable (QR scan, no login).
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if ownsRestaurant(request.resource.data.restaurantId);
      allow update: if ownsRestaurant(request.resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if ownsRestaurant(resource.data.restaurantId);
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if ownsRestaurant(request.resource.data.restaurantId);
      allow update: if ownsRestaurant(request.resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if ownsRestaurant(resource.data.restaurantId);
    }

    // Orders: guests never write directly — only Admin SDK (API) creates.
    // Owners can read and update status for their restaurant.
    match /orders/{orderId} {
      allow read: if ownsRestaurant(resource.data.restaurantId);

      allow create, delete: if false;

      allow update: if ownsRestaurant(resource.data.restaurantId)
        && validOwnerOrderTransition()
        && validOrderStatus(request.resource.data.status)
        // Immutable order identity / money fields
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.shortCode == resource.data.shortCode
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.tableLabel == resource.data.tableLabel
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.total == resource.data.total
        && request.resource.data.accessTokenHash == resource.data.accessTokenHash
        && request.resource.data.clientIdempotencyKey == resource.data.clientIdempotencyKey
        && request.resource.data.createdAt == resource.data.createdAt
        // Only status workflow fields may change (plus optional owner note)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'ownerNote', 'updatedAt', 'statusHistory']);
    }

    // Idempotency ledger — Admin SDK only.
    match /orderIdempotency/{keyId} {
      allow read, write: if false;
    }
  }
}
