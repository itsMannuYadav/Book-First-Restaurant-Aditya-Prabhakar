NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to true only after Firebase Storage is enabled (Blaze plan + storage.rules published).
NEXT_PUBLIC_LOGO_UPLOADS_ENABLED=false

# Firebase Admin (server-only) — required for dine-in order placement.
# Use these three vars from the downloaded service-account JSON:
#   project_id → FIREBASE_ADMIN_PROJECT_ID
#   client_email → FIREBASE_ADMIN_CLIENT_EMAIL
#   private_key → FIREBASE_ADMIN_PRIVATE_KEY (one line, keep \n, wrap in quotes)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Optional alternative (must be a single-line JSON string). Prefer the three vars above.
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Team admin console — comma-separated emails (case-insensitive).
# Set both so server API routes and client login routing stay in sync.
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
